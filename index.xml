rue);&#xA;&#xA;  document.addEventListener(&#39;ended&#39;, (e) =&gt; {&#xA;    if (e.target &amp;&amp; e.target.classList &amp;&amp; e.target.classList.contains(&#39;hymn-audio&#39;)) {&#xA;      const audio = e.target;&#xA;      const currentItem = audio.closest(&#39;.hymn-item&#39;);&#xA;      const currentLine = currentItem ? currentItem.querySelector(&#39;.hymn-line&#39;) : null;&#xA;      if (currentLine) {&#xA;        currentLine.classList.remove(&#39;active&#39;);&#xA;      }&#xA;    }&#xA;  }, true);&#xA;}&#xA;&lt;/script&gt;&#xA;&#xA;&lt;div class=&#34;hymn-item&#34;&gt;&#xA;  &lt;p class=&#34;hymn-line&#34;&gt;Glory to the Father, and to the Son, and to the Holy Spirit, now and ever and unto ages of ages. Amen.&#xA;Holy Immortal! Have mercy on us.&lt;/p&gt;</description>
			</item>
			<item>
				<title>Cherubic Hymn</title>
				<link>https://orthodoxindia.github.io/choir/docs/cherubic_hymn/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>https://orthodoxindia.github.io/choir/docs/cherubic_hymn/</guid>
				<description>&lt;h1 id=&#34;cherubic-hymn&#34;&gt;Cherubic Hymn&lt;a class=&#34;anchor&#34; href=&#34;#cherubic-hymn&#34; aria-label=&#34;Link&#34;&gt;&lt;/a&gt;&lt;/h1&gt;&#xA;&lt;h2 id=&#34;1st-part&#34;&gt;1st Part&lt;a class=&#34;anchor&#34; href=&#34;#1st-part&#34; aria-label=&#34;Link&#34;&gt;&lt;/a&gt;&lt;/h2&gt;&#xA;&lt;p&gt;Let us who mystically represent the cherubim,&lt;/p&gt;&#xA;&lt;p&gt;and who sing the thrice-holy hymn to the life-creating Trinity,&lt;/p&gt;&#xA;&lt;p&gt;now lay aside all earthly cares.&lt;/p&gt;&#xA;&lt;div class=&#34;hymn-audio-wrap&#34;&gt;&#xA;    &lt;audio controls class=&#34;hymn-audio&#34;&gt;&#xA;      &lt;source src=&#34;https://orthodoxindia.github.io/choir/audio/Cherubic_Hymn_Part_1.m4a&#34; type=&#34;audio/mpeg&#34;&gt;&#xA;      Your browser does not support the audio element.&#xA;    &lt;/audio&gt;&#xA;&lt;/div&gt;&#xA;&#xA;&lt;hr&gt;&#xA;&lt;p&gt;Amen.&lt;/p&gt;&#xA;&lt;div class=&#34;hymn-audio-wrap&#34;&gt;&#xA;    &lt;audio controls class=&#34;hymn-audio&#34;&gt;&#xA;      &lt;source src=&#34;https://orthodoxindia.github.io/choir/audio/Cherubic_Hymn_2.m4a&#34; type=&#34;audio/mpeg&#34;&gt;&#xA;      Your browser does not support the audio element.&#xA;    &lt;/audio&gt;&#xA;&lt;/div&gt;&#xA;&#xA;&lt;hr&gt;&#xA;&lt;h2 id=&#34;2nd-part&#34;&gt;2nd Part&lt;a class=&#34;anchor&#34; href=&#34;#2nd-part&#34; aria-label=&#34;Link&#34;&gt;&lt;/a&gt;&lt;/h2&gt;&#xA;&lt;p&gt;That we may receive the King of all,&lt;/p&gt;&#xA;&lt;p&gt;Who comes invisibly upborne by the angelic hosts.&lt;/p&gt;&#xA;&lt;p&gt;Alleluia, alleluia, alleluia.&lt;/p&gt;</description>
			</item>
			<item>
				<title>Litany of Supplication</title>
				<link>https://orthodoxindia.github.io/choir/docs/litany_of_supplication/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>https://orthodoxindia.github.io/choir/docs/litany_of_supplication/</guid>
				<description>&lt;p&gt;Lord, have mercy.&lt;/p&gt;&#xA;&lt;p&gt;Grant it, O Lord.&lt;/p&gt;&#xA;&lt;p&gt;To Thee, O Lord.&lt;/p&gt;</description>
			</item>
			<item>
				<title>Anaphora</title>
				<link>https://orthodoxindia.github.io/choir/docs/anaphora/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>https://orthodoxindia.github.io/choir/docs/anaphora/</guid>
				<description>&lt;p&gt;A mercy of peace, a sacrifice of praise!&lt;/p&gt;&#xA;&lt;p&gt;And with thy spirit.&lt;/p&gt;&#xA;&lt;p&gt;We lift them up unto the Lord.&lt;/p&gt;&#xA;&lt;p&gt;It is fitting and right.&lt;/p&gt;&#xA;&lt;hr&gt;&#xA;&lt;p&gt;Holy! Holy! Holy! Lord of Sabaoth!&lt;/p&gt;&#xA;&lt;p&gt;Heaven and earth are full of Thy glory!&lt;/p&gt;&#xA;&lt;p&gt;Hosanna in the highest!&lt;/p&gt;&#xA;&lt;p&gt;Blessed is He Who comes in the Name of the Lord! Hosanna in the highest!&lt;/p&gt;&#xA;&lt;hr&gt;&#xA;&lt;p&gt;We praise Thee. We bless Thee. We give thanks to Thee, O Lord;&lt;/p&gt;</description>
			</item>
			<item>
				<title>Hymn to the Theotokos</title>
				<link>https://orthodoxindia.github.io/choir/docs/hymn_to_the_theotokos/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>https://orthodoxindia.github.io/choir/docs/hymn_to_the_theotokos/</guid>
				<description>&lt;h1 id=&#34;hymn-to-the-theotokos&#34;&gt;Hymn to the Theotokos&lt;a class=&#34;anchor&#34; href=&#34;#hymn-to-the-theotokos&#34; aria-label=&#34;Link&#34;&gt;&lt;/a&gt;&lt;/h1&gt;&#xA;&lt;p&gt;It is truly meet to bless thee, O Theotokos,&lt;/p&gt;&#xA;&lt;p&gt;ever-blessed and the most pure, and the Mother of our God.&lt;/p&gt;&#xA;&lt;p&gt;More honorable than the cherubim, and more glorious beyond compare than the seraphim:&lt;/p&gt;&#xA;&lt;p&gt;without defilement thou gavest birth to God the Word:&lt;/p&gt;&#xA;&lt;p&gt;true Theotokos, we magnify thee.&lt;/p&gt;&#xA;&lt;div class=&#34;hymn-audio-wrap&#34;&gt;&#xA;    &lt;audio controls class=&#34;hymn-audio&#34;&gt;&#xA;      &lt;source src=&#34;https://orthodoxindia.github.io/choir/audio/It_is_Truly_Meet.m4a&#34; type=&#34;audio/mpeg&#34;&gt;&#xA;      Your browser does not support the audio element.&#xA;    &lt;/audio&gt;&#xA;&lt;/div&gt;</description>
			</item>
			<item>
				<title>Lord&#39;s Prayer</title>
				<link>https://orthodoxindia.github.io/choir/docs/lords_prayer/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>https://orthodoxindia.github.io/choir/docs/lords_prayer/</guid>
				<description>&lt;p&gt;Our Father, Who art in heaven,&lt;/p&gt;&#xA;&lt;p&gt;hallowed be Thy name.&lt;/p&gt;&#xA;&lt;p&gt;Thy kingdom come.&lt;/p&gt;&#xA;&lt;p&gt;Thy will be done, on earth as it is in heaven.&lt;/p&gt;&#xA;&lt;p&gt;Give us this day our daily bread,&lt;/p&gt;&#xA;&lt;p&gt;and forgive us our trespasses as we forgive those who trespass against us.&lt;/p&gt;&#xA;&lt;p&gt;And lead us not into temptation, but deliver us from the evil one.&lt;/p&gt;</description>
			</item>
			<item>
				<title>Liturgy Ending</title>
				<link>https://orthodoxindia.github.io/choir/docs/liturgy_ending/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>https://orthodoxindia.github.io/choir/docs/liturgy_ending/</guid>
				<description>&lt;h1 id=&#34;liturgy-ending&#34;&gt;Liturgy Ending&lt;a class=&#34;anchor&#34; href=&#34;#liturgy-ending&#34; aria-label=&#34;Link&#34;&gt;&lt;/a&gt;&lt;/h1&gt;&#xA;&lt;h2 id=&#34;we-have-seen-the-true-light&#34;&gt;&amp;ldquo;We have seen the true Light&amp;rdquo;&lt;a class=&#34;anchor&#34; href=&#34;#we-have-seen-the-true-light&#34; aria-label=&#34;Link&#34;&gt;&lt;/a&gt;&lt;/h2&gt;&#xA;&lt;p&gt;We have seen the true Light!&lt;/p&gt;&#xA;&lt;p&gt;We have received the heavenly spirit!&lt;/p&gt;&#xA;&lt;p&gt;We have found the true faith!&lt;/p&gt;&#xA;&lt;p&gt;Worshipping the undivided Trinity, who has saved us.&lt;/p&gt;&#xA;&lt;div class=&#34;hymn-audio-wrap&#34;&gt;&#xA;    &lt;audio controls class=&#34;hymn-audio&#34;&gt;&#xA;      &lt;source src=&#34;https://orthodoxindia.github.io/choir/audio/We_Have_Seen_the_True_Light_1.m4a&#34; type=&#34;audio/mpeg&#34;&gt;&#xA;      Your browser does not support the audio element.&#xA;    &lt;/audio&gt;&#xA;&lt;/div&gt;&#xA;&#xA;&lt;hr&gt;&#xA;&lt;p&gt;Amen.&lt;/p&gt;&#xA;&lt;div class=&#34;hymn-audio-wrap&#34;&gt;&#xA;    &lt;audio controls class=&#34;hymn-audio&#34;&gt;&#xA;      &lt;source src=&#34;https://orthodoxindia.github.io/choir/audio/We_Have_Seen_the_True_Light_2.m4a&#34; type=&#34;audio/mpeg&#34;&gt;&#xA;      Your browser does not support the audio element.&#xA;    &lt;/audio&gt;&#xA;&lt;/div&gt;&#xA;&#xA;&lt;hr&gt;&#xA;&lt;p&gt;Let our mouths be filled with Thy praise, O Lord,&lt;/p&gt;&#xA;&lt;p&gt;that we may sing of Thy glory;&lt;/p&gt;</description>
			</item>
	</channel>
