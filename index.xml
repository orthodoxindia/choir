rue);&#xA;&#xA;  document.addEventListener(&#39;ended&#39;, (e) =&gt; {&#xA;    if (e.target &amp;&amp; e.target.classList &amp;&amp; e.target.classList.contains(&#39;hymn-audio&#39;)) {&#xA;      const audio = e.target;&#xA;      const currentItem = audio.closest(&#39;.hymn-item&#39;);&#xA;      const currentLine = currentItem ? currentItem.querySelector(&#39;.hymn-line&#39;) : null;&#xA;      if (currentLine) {&#xA;        currentLine.classList.remove(&#39;active&#39;);&#xA;      }&#xA;    }&#xA;  }, true);&#xA;}&#xA;&lt;/script&gt;&#xA;&#xA;&lt;div class=&#34;hymn-item&#34;&gt;&#xA;  &lt;p class=&#34;hymn-line&#34;&gt;Blessed are the poor in spirit, for theirs is the Kingdom of Heaven.&lt;/p&gt;</description>
			</item>
			<item>
				<title>Entrance Hymn</title>
				<link>https://orthodoxindia.github.io/choir/docs/entrance_hymn/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>https://orthodoxindia.github.io/choir/docs/entrance_hymn/</guid>
				<description>&lt;p&gt;Come, let us worship and fall down before Christ; O Son of God Who didst rise from the dead save us who chant unto Thee: Alleluia.&lt;/p&gt;</description>
			</item>
			<item>
