			<item>
				<title>Great Litany</title>
				<link>https://orthodoxindia.github.io/choir/docs/01_great_litany/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>https://orthodoxindia.github.io/choir/docs/01_great_litany/</guid>
				<description>&lt;h1 id=&#34;great-litany&#34;&gt;Great Litany&lt;a class=&#34;anchor&#34; href=&#34;#great-litany&#34; aria-label=&#34;Link&#34;&gt;&lt;/a&gt;&lt;/h1&gt;&#xA;&lt;div class=&#34;hymn-item&#34;&gt;&#xA;  &lt;p class=&#34;hymn-line&#34;&gt;Lord, have mercy #1&lt;/p&gt;&#xA;  &lt;div class=&#34;hymn-audio-wrap&#34;&gt;&#xA;    &lt;audio controls class=&#34;hymn-audio&#34;&gt;&#xA;      &lt;source src=&#34;https://orthodoxindia.github.io/choir/audio/Lord_have_mercy_1.m4a&#34; type=&#34;audio/mp4&#34;&gt;&#xA;      Your browser does not support the audio element.&#xA;    &lt;/audio&gt;&#xA;  &lt;/div&gt;&#xA;&lt;/div&gt;&#xA;&#xA;&lt;style&gt;&#xA;.hymn-item {&#xA;  margin-bottom: 1.5rem;&#xA;}&#xA;&#xA;.hymn-line {&#xA;  transition: background-color 0.3s ease, color 0.3s ease;&#xA;  padding: 4px 8px;&#xA;  border-radius: 4px;&#xA;}&#xA;&#xA;.hymn-line.active {&#xA;  background-color: #e3f2fd !important;  &#xA;  color: #0d47a1 !important;&#xA;  font-weight: 600;&#xA;}&#xA;&lt;/style&gt;&#xA;&#xA;&lt;script&gt;&#xA;if (typeof window.hymnHooksInitialized === &#39;undefined&#39;) {&#xA;  window.hymnHooksInitialized = true;&#xA;&#xA;  document.addEventListener(&#39;play&#39;, (e) =&gt; {&#xA;    if (e.target &amp;&amp; e.target.classList &amp;&amp; e.target.classList.contains(&#39;hymn-audio&#39;)) {&#xA;      const audio = e.target;&#xA;      const currentItem = audio.closest(&#39;.hymn-item&#39;);&#xA;      const currentLine = currentItem ? currentItem.querySelector(&#39;.hymn-line&#39;) : null;&#xA;&#xA;      document.querySelectorAll(&#39;.hymn-line&#39;).forEach((line) =&gt; {&#xA;        line.classList.remove(&#39;active&#39;);&#xA;      });&#xA;&#xA;      document.querySelectorAll(&#39;.hymn-audio&#39;).forEach((other) =&gt; {&#xA;        if (other !== audio) other.pause();&#xA;      });&#xA;&#xA;      if (currentLine) {&#xA;        currentLine.classList.add(&#39;active&#39;);&#xA;      }&#xA;    }&#xA;  }, true);&#xA;&#xA;  document.addEventListener(&#39;ended&#39;, (e) =&gt; {&#xA;    if (e.target &amp;&amp; e.target.classList &amp;&amp; e.target.classList.contains(&#39;hymn-audio&#39;)) {&#xA;      const audio = e.target;&#xA;      const currentItem = audio.closest(&#39;.hymn-item&#39;);&#xA;      const currentLine = currentItem ? currentItem.querySelector(&#39;.hymn-line&#39;) : null;&#xA;      if (currentLine) {&#xA;        currentLine.classList.remove(&#39;active&#39;);&#xA;      }&#xA;    }&#xA;  }, true);&#xA;}&#xA;&lt;/script&gt;&#xA;&#xA;&lt;div class=&#34;hymn-item&#34;&gt;&#xA;  &lt;p class=&#34;hymn-line&#34;&gt;Lord, have mercy #2&lt;/p&gt;</description>
			</item>
