			<item>
				<title>First Antiphon</title>
				<link>https://orthodoxindia.github.io/choir/docs/02_first_antiphon/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>https://orthodoxindia.github.io/choir/docs/02_first_antiphon/</guid>
				<description>&lt;h1 id=&#34;first-antiphon&#34;&gt;First Antiphon&lt;a class=&#34;anchor&#34; href=&#34;#first-antiphon&#34; aria-label=&#34;Link&#34;&gt;&lt;/a&gt;&lt;/h1&gt;&#xA;&lt;h2 id=&#34;bar-by-bar&#34;&gt;Bar-by-bar&lt;a class=&#34;anchor&#34; href=&#34;#bar-by-bar&#34; aria-label=&#34;Link&#34;&gt;&lt;/a&gt;&lt;/h2&gt;&#xA;&lt;div class=&#34;hymn-item&#34;&gt;&#xA;  &lt;p class=&#34;hymn-line&#34;&gt;Bless the Lord, O my soul.&lt;/p&gt;&#xA;  &lt;div class=&#34;hymn-audio-wrap&#34;&gt;&#xA;    &lt;audio controls class=&#34;hymn-audio&#34;&gt;&#xA;      &lt;source src=&#34;https://orthodoxindia.github.io/choir/audio/A1_B1.m4a&#34; type=&#34;audio/mp4&#34;&gt;&#xA;      Your browser does not support the audio element.&#xA;    &lt;/audio&gt;&#xA;  &lt;/div&gt;&#xA;&lt;/div&gt;&#xA;&#xA;&lt;style&gt;&#xA;.hymn-item {&#xA;  margin-bottom: 1.5rem;&#xA;}&#xA;&#xA;.hymn-line {&#xA;  transition: background-color 0.3s ease, color 0.3s ease;&#xA;  padding: 4px 8px;&#xA;  border-radius: 4px;&#xA;}&#xA;&#xA;.hymn-line.active {&#xA;  background-color: #e3f2fd !important;  &#xA;  color: #0d47a1 !important;&#xA;  font-weight: 600;&#xA;}&#xA;&lt;/style&gt;&#xA;&#xA;&lt;script&gt;&#xA;if (typeof window.hymnHooksInitialized === &#39;undefined&#39;) {&#xA;  window.hymnHooksInitialized = true;&#xA;&#xA;  document.addEventListener(&#39;play&#39;, (e) =&gt; {&#xA;    if (e.target &amp;&amp; e.target.classList &amp;&amp; e.target.classList.contains(&#39;hymn-audio&#39;)) {&#xA;      const audio = e.target;&#xA;      const currentItem = audio.closest(&#39;.hymn-item&#39;);&#xA;      const currentLine = currentItem ? currentItem.querySelector(&#39;.hymn-line&#39;) : null;&#xA;&#xA;      document.querySelectorAll(&#39;.hymn-line&#39;).forEach((line) =&gt; {&#xA;        line.classList.remove(&#39;active&#39;);&#xA;      });&#xA;&#xA;      document.querySelectorAll(&#39;.hymn-audio&#39;).forEach((other) =&gt; {&#xA;        if (other !== audio) other.pause();&#xA;      });&#xA;&#xA;      if (currentLine) {&#xA;        currentLine.classList.add(&#39;active&#39;);&#xA;      }&#xA;    }&#xA;  }, true);&#xA;&#xA;  document.addEventListener(&#39;ended&#39;, (e) =&gt; {&#xA;    if (e.target &amp;&amp; e.target.classList &amp;&amp; e.target.classList.contains(&#39;hymn-audio&#39;)) {&#xA;      const audio = e.target;&#xA;      const currentItem = audio.closest(&#39;.hymn-item&#39;);&#xA;      const currentLine = currentItem ? currentItem.querySelector(&#39;.hymn-line&#39;) : null;&#xA;      if (currentLine) {&#xA;        currentLine.classList.remove(&#39;active&#39;);&#xA;      }&#xA;    }&#xA;  }, true);&#xA;}&#xA;&lt;/script&gt;&#xA;&#xA;&lt;div class=&#34;hymn-item&#34;&gt;&#xA;  &lt;p class=&#34;hymn-line&#34;&gt;Blessed art Thou, O Lord!&lt;/p&gt;</description>
			</item>
			<item>
				<title>Second Antiphon</title>
				<link>https://orthodoxindia.github.io/choir/docs/03_second_antiphon/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>https://orthodoxindia.github.io/choir/docs/03_second_antiphon/</guid>
				<description>&lt;h1 id=&#34;second-antiphon&#34;&gt;Second Antiphon&lt;a class=&#34;anchor&#34; href=&#34;#second-antiphon&#34; aria-label=&#34;Link&#34;&gt;&lt;/a&gt;&lt;/h1&gt;&#xA;&lt;h2 id=&#34;bar-by-bar&#34;&gt;Bar-by-bar&lt;a class=&#34;anchor&#34; href=&#34;#bar-by-bar&#34; aria-label=&#34;Link&#34;&gt;&lt;/a&gt;&lt;/h2&gt;&#xA;&lt;div class=&#34;hymn-item&#34;&gt;&#xA;  &lt;p class=&#34;hymn-line&#34;&gt;Amen. Glory to the Father, and to the Son, and to the Holy Spirit.&lt;/p&gt;&#xA;  &lt;div class=&#34;hymn-audio-wrap&#34;&gt;&#xA;    &lt;audio controls class=&#34;hymn-audio&#34;&gt;&#xA;      &lt;source src=&#34;https://orthodoxindia.github.io/choir/audio/A2_B1-3.m4a&#34; type=&#34;audio/mp4&#34;&gt;&#xA;      Your browser does not support the audio element.&#xA;    &lt;/audio&gt;&#xA;  &lt;/div&gt;&#xA;&lt;/div&gt;&#xA;&#xA;&lt;style&gt;&#xA;.hymn-item {&#xA;  margin-bottom: 1.5rem;&#xA;}&#xA;&#xA;.hymn-line {&#xA;  transition: background-color 0.3s ease, color 0.3s ease;&#xA;  padding: 4px 8px;&#xA;  border-radius: 4px;&#xA;}&#xA;&#xA;.hymn-line.active {&#xA;  background-color: #e3f2fd !important;  &#xA;  color: #0d47a1 !important;&#xA;  font-weight: 600;&#xA;}&#xA;&lt;/style&gt;&#xA;&#xA;&lt;script&gt;&#xA;if (typeof window.hymnHooksInitialized === &#39;undefined&#39;) {&#xA;  window.hymnHooksInitialized = true;&#xA;&#xA;  document.addEventListener(&#39;play&#39;, (e) =&gt; {&#xA;    if (e.target &amp;&amp; e.target.classList &amp;&amp; e.target.classList.contains(&#39;hymn-audio&#39;)) {&#xA;      const audio = e.target;&#xA;      const currentItem = audio.closest(&#39;.hymn-item&#39;);&#xA;      const currentLine = currentItem ? currentItem.querySelector(&#39;.hymn-line&#39;) : null;&#xA;&#xA;      document.querySelectorAll(&#39;.hymn-line&#39;).forEach((line) =&gt; {&#xA;        line.classList.remove(&#39;active&#39;);&#xA;      });&#xA;&#xA;      document.querySelectorAll(&#39;.hymn-audio&#39;).forEach((other) =&gt; {&#xA;        if (other !== audio) other.pause();&#xA;      });&#xA;&#xA;      if (currentLine) {&#xA;        currentLine.classList.add(&#39;active&#39;);&#xA;      }&#xA;    }&#xA;  }, true);&#xA;&#xA;  document.addEventListener(&#39;ended&#39;, (e) =&gt; {&#xA;    if (e.target &amp;&amp; e.target.classList &amp;&amp; e.target.classList.contains(&#39;hymn-audio&#39;)) {&#xA;      const audio = e.target;&#xA;      const currentItem = audio.closest(&#39;.hymn-item&#39;);&#xA;      const currentLine = currentItem ? currentItem.querySelector(&#39;.hymn-line&#39;) : null;&#xA;      if (currentLine) {&#xA;        currentLine.classList.remove(&#39;active&#39;);&#xA;      }&#xA;    }&#xA;  }, true);&#xA;}&#xA;&lt;/script&gt;&#xA;&#xA;&lt;div class=&#34;hymn-item&#34;&gt;&#xA;  &lt;p class=&#34;hymn-line&#34;&gt;Praise the Lord, O my soul!&lt;/p&gt;</description>
			</item>
			<item>
				<title>Hymn of Incarnation</title>
				<link>https://orthodoxindia.github.io/choir/docs/hymn_of_incarnation/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>https://orthodoxindia.github.io/choir/docs/hymn_of_incarnation/</guid>
				<description>&lt;p&gt;Only-begotten Son and immortal Word of God,&lt;/p&gt;&#xA;&lt;p&gt;Who for our salvation willed to be incarnate&lt;/p&gt;&#xA;&lt;p&gt;of the holy Theotokos and ever-virgin Mary,&lt;/p&gt;&#xA;&lt;p&gt;who without change became man and was crucified,&lt;/p&gt;&#xA;&lt;p&gt;O Christ our God, trampling down death by death.&lt;/p&gt;&#xA;&lt;p&gt;Thou art one of the Holy Trinity,&lt;/p&gt;&#xA;&lt;p&gt;glorified with the Father and the Holy Spirit.&lt;/p&gt;&#xA;&lt;p&gt;Save us!&lt;/p&gt;</description>
			</item>
			<item>
				<title>Third Antiphon</title>
				<link>https://orthodoxindia.github.io/choir/docs/third_antiphon/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
